# Hostinger (Apache). Dominio principal: movimientopatriam.org
RewriteEngine On

# El boletín vive en boletin.movimientopatriam.org (desde cualquier dominio)
RewriteCond %{HTTP_HOST} ^boletin\.movimientopatriam\.(es|com|net)$ [NC]
RewriteRule ^(.*)$ https://boletin.movimientopatriam.org/$1 [R=301,L]

# Espejos (.es, .com, .net y www) -> dominio principal
RewriteCond %{HTTP_HOST} ^(www\.)?movimientopatriam\.(es|com|net)$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.movimientopatriam\.org$ [NC]
RewriteRule ^(.*)$ https://movimientopatriam.org/$1 [R=301,L]

# La web es una sola página: cualquier ruta la sirve index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
</IfModule>
